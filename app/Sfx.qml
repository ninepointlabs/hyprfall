import QtQuick

// Chiptune sound effects and the two rock loops, all generated by
// tools/make-sounds.py. `muted` silences everything; M toggles it in game.
// The QtMultimedia half lives in SfxBackend.qml; if that module isn't
// installed the Loader fails quietly and the game plays on in silence.
Item {
  id: root

  property bool muted: false
  property real musicVolume: 0.45
  property real effectsVolume: 0.8
  // "title", "jungle" or "" for silence
  property string track: ""

  readonly property var names: ["jump", "grab", "release", "treasure", "bump", "thud", "splash", "sink", "death", "gameover", "win", "start", "pause"]
  readonly property bool available: backend.status === Loader.Ready

  function play(name) {
    if (muted || !name || !available || names.indexOf(name) < 0) return
    backend.item.play(name)
  }

  function syncMusic() {
    if (!available) return
    backend.item.music(muted ? "" : track)
  }

  Loader {
    id: backend
    source: Qt.resolvedUrl("SfxBackend.qml")
    onLoaded: {
      item.names = root.names
      root.syncMusic()
    }
    onStatusChanged: if (status === Loader.Error) console.warn("hyprfall: QtMultimedia isn't available, so the jungle is silent (install your distro's Qt 6 multimedia QML module for sound)")
  }

  Binding { target: backend.item; property: "muted"; value: root.muted; when: root.available }
  Binding { target: backend.item; property: "musicVolume"; value: root.musicVolume; when: root.available }
  Binding { target: backend.item; property: "effectsVolume"; value: root.effectsVolume; when: root.available }

  onTrackChanged: syncMusic()
  onMutedChanged: syncMusic()
}
