#!/bin/bash
# Hyprfall launcher.
#
#   hyprfall             start the game, or focus it if it's already running
#   hyprfall --tiled     start it without floating the window
#   hyprfall --version   print the version
#   hyprfall --about     print the About screen (F1 in game) as plain text
#   hyprfall --selftest  load the game headless, play a second, exit 0 if it ran
#
# The game is a Quickshell app (app/shell.qml). On Hyprland it opens as a
# centered, floating 16:10 window sized to the focused monitor; nothing is
# written to your Hyprland config for that, it's done with dispatchers when
# the window appears.
set -euo pipefail

here="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
app="$(cd "$here/../app" && pwd)"
title="Hyprfall"
tiled=0

version="$(cat "$here/../VERSION" 2>/dev/null || echo dev)"

case "${1:-}" in
  --version)
    echo "hyprfall $version"
    exit 0
    ;;
  --about)
    # the same facts as the in-game About screen, from app/About.js
    fact() { sed -n "s/^  $1: \"\(.*\)\",\{0,1\}\( *\/\/.*\)\{0,1\}\$/\1/p" "$app/About.js"; }
    qs="$(quickshell --version 2>/dev/null | head -n 1 || true)"
    qt=""
    for q in qtpaths6 qtpaths /usr/lib/qt6/bin/qtpaths /usr/lib/*-linux-gnu/qt6/bin/qtpaths /usr/lib64/qt6/bin/qtpaths; do
      qt="$("$q" --qt-version 2>/dev/null || true)" && [[ -n $qt ]] && break
    done
    echo "$(fact name) $version"
    fact tagline
    echo
    echo "Made by     $(fact organization)"
    echo "Created     $(fact created)"
    echo "License     $(fact license), $(fact copyright) (full text: $(readlink -f "$here/../LICENSE"))"
    echo "Support     $(fact supportEmail)"
    echo "Built with  ${qs:-Quickshell not found}${qt:+, Qt $qt}"
    echo
    echo "Privacy: $(fact privacy)"
    echo
    echo "Credits: $(fact credits)"
    exit 0
    ;;
  --tiled) tiled=1 ;;
  --selftest | "") ;;
  *) echo "usage: hyprfall [--tiled | --version | --about | --selftest]" >&2; exit 2 ;;
esac

if ! command -v quickshell >/dev/null 2>&1; then
  msg="Hyprfall needs Quickshell (https://quickshell.org): install your distro's quickshell package."
  echo "hyprfall: $msg" >&2
  command -v notify-send >/dev/null 2>&1 && notify-send "Hyprfall" "$msg" || true
  exit 1
fi

# Quickshell 0.3 or newer: older ones reject the AppId pragma in shell.qml.
# If no version can be read, carry on and let Quickshell speak for itself.
qs_version="$(quickshell --version 2>/dev/null | head -n 1 | grep -oE '[0-9]+\.[0-9]+(\.[0-9]+)?' | head -n 1 || true)"
if [[ $qs_version =~ ^([0-9]+)\.([0-9]+) ]] &&
  ((BASH_REMATCH[1] == 0 && BASH_REMATCH[2] < 3)); then
  msg="Hyprfall needs Quickshell 0.3 or newer (found $qs_version)."
  echo "hyprfall: $msg" >&2
  command -v notify-send >/dev/null 2>&1 && notify-send "Hyprfall" "$msg" || true
  exit 1
fi

if [[ ${1:-} == "--selftest" ]]; then
  # No compositor needed: run offscreen with a throwaway runtime dir and
  # state, and let shell.qml report whether the game loop actually ran.
  tmp="$(mktemp -d)"
  trap 'rm -rf -- "$tmp"' EXIT
  out="$(HYPRFALL_SELFTEST=1 QT_QPA_PLATFORM=offscreen XDG_RUNTIME_DIR="$tmp" XDG_STATE_HOME="$tmp/state" \
    timeout 30 quickshell --path "$app" 2>&1 || true)"
  if grep -q "hyprfall: selftest ok" <<<"$out"; then
    grep "hyprfall: selftest ok" <<<"$out"
    exit 0
  fi
  echo "$out" >&2
  echo "hyprfall: selftest FAILED" >&2
  exit 1
fi

have_hypr() { command -v hyprctl >/dev/null 2>&1 && hyprctl version >/dev/null 2>&1; }

window_address() {
  have_hypr || return 0
  hyprctl clients -j 2>/dev/null | jq -r --arg t "$title" '.[] | select(.title == $t) | .address' | head -n 1
}

addr="$(window_address)"
if [[ -n $addr ]]; then
  hyprctl dispatch "hl.dsp.focus({ window = \"address:$addr\" })" >/dev/null 2>&1 ||
    hyprctl dispatch focuswindow "address:$addr" >/dev/null 2>&1 || true
  exit 0
fi

quickshell --no-duplicate --daemonize --path "$app" >/dev/null 2>&1

have_hypr || exit 0

for _ in $(seq 60); do
  addr="$(window_address)"
  [[ -n $addr ]] && break
  sleep 0.1
done
[[ -n $addr ]] || exit 0

# Fully opaque, like Omarchy does for Steam and RetroArch: the default
# window translucency lets the terminal behind bleed through the jungle.
for prop in opacity opacity_inactive; do
  hyprctl dispatch "hl.dsp.window.set_prop({ prop = \"$prop\", value = \"1\", window = \"address:$addr\" })" >/dev/null 2>&1 || true
done

((tiled)) && exit 0

# 16:10, as big as fits in 80% of the focused monitor (logical pixels)
read -r mw mh < <(hyprctl monitors -j | jq -r '.[] | select(.focused) | "\((.width / .scale) | floor) \((.height / .scale) | floor)"')
w=$((mw * 80 / 100))
h=$((w * 10 / 16))
if ((h > mh * 85 / 100)); then
  h=$((mh * 85 / 100))
  w=$((h * 16 / 10))
fi

hyprctl dispatch "hl.dsp.window.float({ action = \"enable\", window = \"address:$addr\" })" >/dev/null 2>&1 || true
hyprctl dispatch "hl.dsp.window.resize({ x = $w, y = $h, exact = true, window = \"address:$addr\" })" >/dev/null 2>&1 || true
hyprctl dispatch "hl.dsp.window.center({ window = \"address:$addr\" })" >/dev/null 2>&1 || true
