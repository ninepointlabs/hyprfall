<component type="desktop-application">
  <id>com.ninepointlabs.hyprfall</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>Hyprfall</name>
  <summary>A jungle caper for Omarchy</summary>
  <developer id="com.ninepointlabs">
    <name>Nine Point Labs</name>
  </developer>
  <description>
    <p>
      A jungle platformer: swing on ethernet cables over tarballs and anti-AI garden gnomes,
      and find 32 treasures in 20 minutes.
    </p>
    <p>
      Hyprfall is made for Omarchy, where the jungle wears your current theme's colours and
      repaints live when you switch themes. Everywhere else it plays in its own Tokyo Night colours.
    </p>
    <p>
      No accounts, no telemetry and no network access. High scores and the mute switch are saved
      in your home directory.
    </p>
  </description>
  <launchable type="desktop-id">hyprfall.desktop</launchable>
  <icon type="stock">hyprfall</icon>
