# Maintainer: Tim <tim@ninepointlabs.com>
pkgname=hyprfall
pkgver=0.1.1
pkgrel=1
pkgdesc='Jungle platformer native to Omarchy: ethernet cables, tarballs and anti-AI garden gnomes'
arch=('any')
url='https://github.com/ninepointlabs/hyprfall'
license=('MIT')
depends=(
  'bash'
  'hicolor-icon-theme'
  'quickshell'
  'qt6-declarative'
)
optdepends=(
  'qt6-multimedia: music and sound effects'
  'jq: float, size and focus the window on Hyprland'
  'libnotify: a desktop notification if Quickshell is missing'
)
checkdepends=('nodejs')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('a1cea7ec6ce231485410eb69bdf3b7e87941c43107e764f3c7a6ec4cd690e67c')

check() {
  cd "$pkgname-$pkgver"
  node test/engine.js
}

package() {
  cd "$pkgname-$pkgver"
  packaging/stage.sh "$pkgdir" "$pkgver"
}
